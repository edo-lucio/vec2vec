#!/bin/bash
#SBATCH --job-name=simple
#SBATCH --output=job.%j.out
#SBATCH --cpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH --gres=gpu
#SBATCH --partition=scavenge

for d in finetuning_unsupervised/*/; do
    folder_name=$(basename "$d")
    echo "Running eval on $folder_name"

    apptainer exec --nv -B /home/edlu/vec2vec/:/v2v vec_image.sif bash -c "
        export HOME=/v2v/.cache/job_baseline${SLURM_JOB_ID}_${folder_name}
        micromamba run -n vec conda install conda-forge::pot \ 
            python -s /v2v/ot_baseline.py finetuning_unsupervised/${folder_name} unsupervised
    "
done
